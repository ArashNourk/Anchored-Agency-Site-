# Velocity -> filter env and amp; aftertouch -> filter cutoff, then -> LFO amount.
oversample 4
set A.flt_cutoff 0.35
set A.flt_env_amt 0.5
set A.flt_vel 1
set A.aenv_vel 1
set A.fenv_decay 0.45
set A.aenv_sustain 0.7
at 0.0 on 48 20
at 0.8 off 48
at 1.0 on 48 50
at 1.8 off 48
at 2.0 on 48 80
at 2.8 off 48
at 3.0 on 48 110
at 3.8 off 48
at 4.0 on 48 127
at 4.8 off 48
at 5.5 set A.at_filter 1
at 5.5 on 48 100
ramp 6 8 A.flt_cutoff 0.35 0.35
at 6.0 pressure 0.25
at 6.5 pressure 0.5
at 7.0 pressure 0.75
at 7.5 pressure 1.0
at 8.0 pressure 0
at 8.5 set A.at_filter 0
at 8.5 set A.at_lfo_amount 1
at 8.5 set A.wm_freq_a 1
at 9.0 pressure 0.5
at 10.0 pressure 1.0
at 11.0 pressure 0
at 11.5 off 48
length 12
