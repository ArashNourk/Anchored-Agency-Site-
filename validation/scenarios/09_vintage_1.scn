# Vintage 1: 20 staccato chromatic notes C3..G4 (rotating through all ten voices;
# repeating ONE key would stay on one voice, see A-VAL-02)
# then a 10-note chord. Per-note pitch, brightness, level and envelope timing
# give the voice-to-voice spread (`p10analyze noteseq`).
oversample 4
set A.vintage 1
set A.osca_saw 1
set A.flt_cutoff 0.55
set A.flt_resonance 0.3
set A.flt_env_amt 0.35
set A.fenv_decay 0.45
set A.aenv_attack 0
set A.aenv_sustain 0.8
set A.aenv_release 0.3
at 0.0 on 48 100
at 0.35 off 48
at 0.5 on 49 100
at 0.85 off 49
at 1.0 on 50 100
at 1.35 off 50
at 1.5 on 51 100
at 1.85 off 51
at 2.0 on 52 100
at 2.35 off 52
at 2.5 on 53 100
at 2.85 off 53
at 3.0 on 54 100
at 3.35 off 54
at 3.5 on 55 100
at 3.85 off 55
at 4.0 on 56 100
at 4.35 off 56
at 4.5 on 57 100
at 4.85 off 57
at 5.0 on 58 100
at 5.35 off 58
at 5.5 on 59 100
at 5.85 off 59
at 6.0 on 60 100
at 6.35 off 60
at 6.5 on 61 100
at 6.85 off 61
at 7.0 on 62 100
at 7.35 off 62
at 7.5 on 63 100
at 7.85 off 63
at 8.0 on 64 100
at 8.35 off 64
at 8.5 on 65 100
at 8.85 off 65
at 9.0 on 66 100
at 9.35 off 66
at 9.5 on 67 100
at 9.85 off 67
at 10.5 on 48 100
at 10.5 on 52 100
at 10.5 on 55 100
at 10.5 on 59 100
at 10.5 on 62 100
at 10.5 on 64 100
at 10.5 on 67 100
at 10.5 on 71 100
at 10.5 on 74 100
at 10.5 on 76 100
at 14.5 off 48
at 14.5 off 52
at 14.5 off 55
at 14.5 off 59
at 14.5 off 62
at 14.5 off 64
at 14.5 off 67
at 14.5 off 71
at 14.5 off 74
at 14.5 off 76
length 16
