# Repeated-note behaviour: legato-ish re-strikes of the same key during the
# release, faster than the release time; then alternating two keys.
oversample 4
set A.flt_cutoff 0.5
set A.flt_env_amt 0.4
set A.fenv_decay 0.4
set A.aenv_attack 0.1
set A.aenv_release 0.5
at 0.0 on 60 100
at 0.12 off 60
at 0.25 on 60 100
at 0.37 off 60
at 0.5 on 60 100
at 0.62 off 60
at 0.75 on 60 100
at 0.87 off 60
at 1.0 on 60 100
at 1.12 off 60
at 1.25 on 60 100
at 1.37 off 60
at 1.5 on 60 100
at 1.62 off 60
at 1.75 on 60 100
at 1.87 off 60
at 2.0 on 60 100
at 2.12 off 60
at 2.25 on 60 100
at 2.37 off 60
at 2.5 on 60 100
at 2.62 off 60
at 2.75 on 60 100
at 2.87 off 60
at 3.0 on 60 100
at 3.12 off 60
at 3.25 on 60 100
at 3.37 off 60
at 3.5 on 60 100
at 3.62 off 60
at 3.75 on 60 100
at 3.87 off 60
at 5.0 on 60 100
at 5.12 off 60
at 5.25 on 67 100
at 5.37 off 67
at 5.5 on 60 100
at 5.62 off 60
at 5.75 on 67 100
