# Voice fingerprint: 30 strikes over 10 different keys (C4..A4, repeated 3x),
# poly mode. Each key lands on one voice; per-voice pitch, level and decay give
# the unit's voice profile (A-UNIT-01). Hardware voice order is matched by
# cyclic alignment, so the instrument's rotation start does not matter.
oversample 2
set A.flt_cutoff 0.85
set A.flt_kbd 2
set A.aenv_attack 0
set A.aenv_decay 0.5
set A.aenv_sustain 0
set A.aenv_release 0.3
at 0.0 on 60 100
at 0.3 off 60
at 0.45 on 61 100
at 0.75 off 61
at 0.9 on 62 100
at 1.2 off 62
at 1.35 on 63 100
at 1.65 off 63
at 1.8 on 64 100
at 2.1 off 64
at 2.25 on 65 100
at 2.55 off 65
at 2.7 on 66 100
at 3.0 off 66
at 3.15 on 67 100
at 3.45 off 67
at 3.6 on 68 100
at 3.9 off 68
at 4.05 on 69 100
at 4.35 off 69
at 4.5 on 60 100
at 4.8 off 60
at 4.95 on 61 100
at 5.25 off 61
at 5.4 on 62 100
at 5.7 off 62
at 5.85 on 63 100
at 6.15 off 63
at 6.3 on 64 100
at 6.6 off 64
at 6.75 on 65 100
at 7.05 off 65
at 7.2 on 66 100
at 7.5 off 66
at 7.65 on 67 100
at 7.95 off 67
at 8.1 on 68 100
at 8.4 off 68
at 8.55 on 69 100
at 8.85 off 69
at 9.0 on 60 100
at 9.3 off 60
at 9.45 on 61 100
at 9.75 off 61
at 9.9 on 62 100
at 10.2 off 62
at 10.35 on 63 100
at 10.65 off 63
at 10.8 on 64 100
at 11.1 off 64
at 11.25 on 65 100
at 11.55 off 65
at 11.7 on 66 100
at 12.0 off 66
at 12.15 on 67 100
at 12.45 off 67
at 12.6 on 68 100
at 12.9 off 68
at 13.05 on 69 100
at 13.35 off 69
# Anchor: one unison-1 note identifies which voice the single-voice tests use.
at 13.6 set A.unison 1
at 13.6 set A.unison_voices 1
at 13.7 on 60 100
at 14.0 off 60
length 14.6
