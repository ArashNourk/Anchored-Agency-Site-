# Resonance onset: resonance swept slowly from 0.70 to 1.0 with no input; the
# knob position where self-oscillation appears, then the level at full
# resonance. Rev1/2 filter first, then Rev3.
oversample 2
set A.unison 1
set A.unison_voices 1
set A.mix_osca 0
set A.flt_kbd 0
set A.flt_cutoff 0.6
set A.aenv_attack 0
set A.aenv_sustain 1
set A.flt_resonance 0.70
at 0 on 60 100
ramp 0.5 6.5 A.flt_resonance 0.70 1.0
at 8.0 set A.flt_rev 1
at 8.0 set A.flt_resonance 0.70
ramp 8.5 14.5 A.flt_resonance 0.70 1.0
at 16.0 off 60
length 16.2
