# LFO triangle -> Freq A at initial amount 0.5, three rate knob positions.
oversample 2
set A.unison 1
set A.unison_voices 1
set A.lfo_tri 1
set A.wm_freq_a 1
set A.wm_freq_b 0
set A.lfo_initial_amount 0.5
set A.flt_cutoff 1
set A.aenv_attack 0
set A.aenv_sustain 1
set A.lfo_freq 0.5
at 0 on 60 100
at 3 set A.lfo_freq 0.65
at 6 set A.lfo_freq 0.8
at 9 off 60
length 9.1
